    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Valida el pedido del back end antes de mandar nada.\nconst { email, code } = $json.body || {};\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email || '') || !/^\\d{6}$/.test(String(code || ''))) {\n  throw new Error('Pedido inválido: se espera { \"email\": \"nombre@dominio\", \"code\": \"123456\" }');\n}\nreturn { json: { email, code: String(code) } };"
      },
      "id": "c01c6d7e-62c3-4dee-afa6-bcdfc6a1239f",
      "name": "Validar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.code }} es tu código de Ashfield",
        "emailType": "text",
        "message": "={{ $json.code }} es tu código de verificación de Ashfield. Vence en 10 minutos.\n\nSi no lo pediste, ignorá este correo.",
        "options": {
          "appendAttribution": false
        }
