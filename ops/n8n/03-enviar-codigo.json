    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Valida el pedido del back end antes de mandar nada.\nconst { phone, code } = $json.body || {};\nif (!/^\\+\\d{8,15}$/.test(phone || '') || !/^\\d{6}$/.test(String(code || ''))) {\n  throw new Error('Pedido inválido: se espera { \"phone\": \"+549...\", \"code\": \"123456\" }');\n}\nreturn { json: { phone, code: String(code) } };"
      },
      "id": "2292fa96-e401-487a-a26b-428e8f1d00fe",
      "name": "Validar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "from": "+14155238886",
        "to": "={{ $json.phone }}",
        "toWhatsapp": true,
        "message": "={{ $json.code }} es tu código de verificación de Ashfield. Vence en 10 minutos. No lo compartas."
      },
      "id": "9b95b8d8-df76-497a-a979-dc2daf526bf3",
